.solutions-hero{display:grid;grid-template-columns:minmax(0,42%) minmax(0,58%);min-height:228px;background:linear-gradient(90deg,#fff 0 42%,#edf1f5 42%)}.solutions-copy{padding:25px 32px 20px 50px;align-self:center}.solutions-copy h1{font-size:37px!important;line-height:1.08}.solutions-copy .rule{width:58px;margin:9px 0}.solutions-copy>p:not(.eyebrow){max-width:460px;margin:0;font-size:13px;line-height:1.5}.solutions-image{position:relative;background:url('https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1300&q=85') center/cover}.solutions-image::before{content:'';position:absolute;left:-55px;top:0;bottom:0;width:100px;background:#fff;clip-path:polygon(0 0,78% 0,100% 100%,0 100%)}.solutions-cards{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;padding:10px 34px 14px}.solutions-cards article{display:flex;min-width:0;min-height:190px;flex-direction:column;align-items:center;padding:13px;border:1px solid #e1e6ed;border-radius:7px;background:#fff;text-align:center}.solutions-cards article>i{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;font-size:25px}.education>i{background:#eee8ff;color:#16106b}.development>i{background:#fff0e4;color:#f07100}.wellbeing>i{background:#e3f8ed;color:#008f62}.care>i{background:#e7f0ff;color:#0960c2}.talent>i{background:#fff6da;color:#ce8500}.organisation>i{background:#ffe8ef;color:#df4c75}.solutions-cards h2{margin:9px 0 7px;font-size:13px!important;line-height:1.15}.solutions-cards p{margin:0;font-size:9px;line-height:1.4}.solutions-cards a{margin-top:auto;padding-top:12px;font-size:10px;font-weight:800}.solutions-cards a i{margin-left:8px}.education a{color:#8d65bd}.development a{color:#f07100}.wellbeing a{color:#008f62}.care a{color:#0960c2}.talent a{color:#be8511}.organisation a{color:#df4c75}.match-strip{display:grid;grid-template-columns:54px minmax(0,1fr) 160px;gap:14px;align-items:center;margin:0 34px 12px;padding:10px 14px;border:1px solid #ddd1f3;border-radius:7px;background:#f3eeff}.match-strip>i{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:#061633;color:#f58a07;font-size:23px}.match-strip h2{font-size:17px!important}.match-strip p{margin:3px 0 0;font-size:9px;line-height:1.35}.match-strip .button{padding:9px 16px;text-align:center}.match-strip .button i{margin-left:12px}.value-band{display:grid;grid-template-columns:210px repeat(5,minmax(0,1fr));align-items:center;padding:13px 48px;background:#061633;color:#fff}.value-heading{padding-left:18px;border-left:6px solid #f58a07;font:800 25px/1.05 'Manrope',sans-serif}.value-heading span{color:#f58a07}.value-band article{display:grid;justify-items:center;gap:5px;min-width:0;padding:0 14px;border-left:1px solid #385070;text-align:center}.value-band i{color:#f58a07;font-size:27px}.value-band strong{font-size:10px;line-height:1.2}@media(max-width:1000px){.solutions-copy{padding-left:24px}.solutions-cards{grid-template-columns:repeat(3,minmax(0,1fr));padding-inline:24px}.match-strip{margin-inline:24px}.value-band{grid-template-columns:180px repeat(3,minmax(0,1fr));gap:16px;padding-inline:24px}.value-heading{grid-row:span 2}}@media(max-width:700px){.solutions-hero{grid-template-columns:1fr}.solutions-copy{padding:28px 16px}.solutions-image{min-height:220px}.solutions-image::before{display:none}.solutions-cards{grid-template-columns:1fr 1fr;padding:16px}.match-strip{grid-template-columns:54px minmax(0,1fr);margin:0 16px 20px}.match-strip .button{grid-column:1/-1;width:100%}.value-band{grid-template-columns:1fr 1fr;padding:22px 16px}.value-heading{grid-column:1/-1;grid-row:auto}.value-band article{border-left:0;border-top:1px solid #385070;padding-top:14px}}@media(max-width:400px){.solutions-copy h1{font-size:31px!important}.solutions-cards,.value-band{grid-template-columns:1fr}.match-strip{grid-template-columns:1fr;justify-items:center;text-align:center}.value-band article{grid-column:auto!important}}